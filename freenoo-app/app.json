{
  "expo": {
    "name": "FreeNoo",
    "slug": "freenoo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.freenoo.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0B0F"
      },
      "package": "com.freenoo.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "mimeType": "application/pdf"
            }
          ]
        }
      ],
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA"
      ],
      "versionCode": 5,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Allow FreeNoo to access your camera for scanning."
        }
      ],
      "@config-plugins/react-native-pdf",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0F",
          "imageWidth": 200
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# react-native-pdf: viewer library and the React Native bridge (no rules of their own;\n# PDFium itself ships consumer rules for its JNI classes)\n-keep class com.github.barteksc.pdfviewer.** { *; }\n-keep class org.wonday.pdf.** { *; }\n# react-native-blob-util: native module + response handlers\n-keep class com.ReactNativeBlobUtil.** { *; }\n-dontwarn org.apache.commons.lang3.**"
          }
        }
      ]
    ],
    "scheme": "freenoo",
    "extra": {
      "eas": {
        "projectId": "eb451299-a9a9-4801-9870-eeccc1057a42"
      }
    }
  }
}
